# Copy to .env and fill in. .env is gitignored.

# Signs login tokens. Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Postgres password for the bundled database container.
POSTGRES_PASSWORD=haven

# Port the site is served on.
HTTP_PORT=8080

# Set by CI on the server; leave unset locally to build images on your machine.
# IMAGE_PREFIX=123456789012.dkr.ecr.ap-southeast-1.amazonaws.com/haven
# IMAGE_TAG=latest
